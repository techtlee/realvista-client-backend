DATABASE_URL=postgresql://<your-postgres-user>@localhost:5432/<your-database-name>
PAYLOAD_SECRET=YOUR_SECRET_HERE

# ── Fallback addresses ───────────────────────────────────────────────────────
# Base domain for the fallback addresses every client gets before their own DNS
# is ready: <client>.realvista.cz (site) and admin.<client>.realvista.cz (this
# backend). See ARCHITECTURE.md, "Domains, per client". Nothing in this app
# reads it yet; it is listed so each client backend is provisioned with it.
PLATFORM_SUBDOMAIN_BASE=realvista.cz

# ── Object storage (Cloudflare R2) ──────────────────────────────────────────
# Leave unset in development: uploads fall back to local disk.
# Required in production — the config throws at boot if NODE_ENV=production
# and these are missing, because a serverless filesystem loses uploads silently.
# (That includes `NODE_ENV=production pnpm migrate`; any non-empty values
# satisfy the check there, since migrations never touch storage.)
R2_BUCKET=
R2_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Public origin bound to the bucket, used to serve images.
R2_PUBLIC_URL=
