DATABASE_URL=mongodb://127.0.0.1/your-database-name
PAYLOAD_SECRET=YOUR_SECRET_HERE

# ── Object storage (Cloudflare R2) ──────────────────────────────────────────
# Leave unset in development: uploads fall back to local disk.
# Required in production — the config throws at boot if NODE_ENV=production
# and these are missing, because a serverless filesystem loses uploads silently.
R2_BUCKET=
R2_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Public origin bound to the bucket, used to serve images.
R2_PUBLIC_URL=
